<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistant_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="12dp"
    android:background="@drawable/assistant_widget_background"
    android:contentDescription="@string/assistant_widget_accessibility"
    android:focusable="true"
    android:clickable="true">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="72dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/assistant_widget_momo"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:importantForAccessibility="noHideDescendants">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assistant_widget_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#354438"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assistant_widget_subtitle"
            android:textSize="13sp"
            android:textColor="#465848"
            android:maxLines="2"
            android:ellipsize="end" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/assistant_widget_action"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#375A3B"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
